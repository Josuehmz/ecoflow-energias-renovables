# Copia este archivo como .env.local y llena los valores del Supabase LOCAL:
#   supabase status -o env   →  API_URL y ANON_KEY (o PUBLISHABLE_KEY)
# .env.local NO se sube al repositorio (está en .gitignore).
# Solo la clave anon/publishable: la service_role nunca va en el frontend ni lleva el prefijo VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
